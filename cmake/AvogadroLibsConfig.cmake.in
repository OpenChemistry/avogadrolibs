# AvogadroLibs CMake configuration file - http://www.openchemistry.org/

# If this file was found, then OpenQube has been found
set(AvogadroLibs_FOUND 1)

set(AvogadroLibs_VERSION_MAJOR   "@AvogadroLibs_VERSION_MAJOR@")
set(AvogadroLibs_VERSION_MINOR   "@AvogadroLibs_VERSION_MINOR@")
set(AvogadroLibs_VERSION_PATCH   "@AvogadroLibs_VERSION_PATCH@")
set(AvogadroLibs_VERSION         "${AvogadroLibs_VERSION_MAJOR}.${AvogadroLibs_VERSION_MINOR}.${AvogadroLibs_VERSION_PATCH}")

set(AvogadroLibs_INSTALL_PREFIX  "@CMAKE_INSTALL_PREFIX@")
set(AvogadroLibs_INCLUDE_DIRS    "${AvogadroLibs_INSTALL_PREFIX}/@INSTALL_INCLUDE_DIR@")
set(AvogadroLibs_LIBRARY_DIR     "${AvogadroLibs_INSTALL_PREFIX}/@INSTALL_LIBRARY_DIR@")
set(AvogadroLibs_RUNTIME_DIR     "${AvogadroLibs_INSTALL_PREFIX}/@INSTALL_RUNTIME_DIR@")
set(AvogadroLibs_DATA_DIR        "${AvogadroLibs_INSTALL_PREFIX}/@INSTALL_DATA_DIR@")
set(AvogadroLibs_CMAKE_DIR       "${AvogadroLibs_LIBRARY_DIR}/cmake/avogadrolibs")

# List of target names that are plugins:
set(AvogadroLibs_PLUGINS         "@AvogadroLibs_PLUGINS@")
set(AvogadroLibs_STATIC_PLUGINS  "@AvogadroLibs_STATIC_PLUGINS@")

# Optional feature flags
set(AvogadroLibs_USE_SUBPROCESS       "@USE_SUBPROCESS@")
set(AvogadroLibs_USE_EMSCRIPTEN       "@EMSCRIPTEN@")
set(AvogadroLibs_BUILD_SHARED_LIBS    "@BUILD_SHARED_LIBS@")
set(AvogadroLibs_BUILD_STATIC_PLUGINS "@BUILD_STATIC_PLUGINS@")
set(AvogadroLibs_USE_PLOTTER          "@USE_PLOTTER@")
set(AvogadroLibs_USE_OPENGL           "@USE_OPENGL@")
set(AvogadroLibs_USE_SPGLIB           "@USE_SPGLIB@")
set(AvogadroLibs_USE_LIBARCHIVE       "@USE_LIBARCHIVE@")
set(AvogadroLibs_USE_LIBMSYM          "@USE_LIBMSYM@")

include(CMakeFindDependencyMacro)

if (@QT_VERSION@ EQUAL 6)
  find_dependency(Qt6OpenGLWidgets)
  find_dependency(Qt6Widgets)
  find_dependency(Qt6Core)
  find_dependency(Qt6Gui)
  find_dependency(Qt6Network)
  find_dependency(Qt6Concurrent)
  if(AvogadroLibs_USE_PLOTTER)
    find_dependency(JKQTPlotter6 REQUIRED)
  endif()
endif()

if(AvogadroLibs_USE_SPGLIB)
  find_dependency(Spglib REQUIRED)
endif()

if(AvogadroLibs_USE_OPENGL AND NOT AvogadroLibs_USE_EMSCRIPTEN)
  find_dependency(GLEW REQUIRED)
endif()

if(AvogadroLibs_USE_LIBARCHIVE)
  find_dependency(LibArchive REQUIRED)
endif()

if(AvogadroLibs_USE_LIBMSYM)
  find_dependency(libmsym CONFIG REQUIRED)
endif()

# Static libraries and static plugins expose their header-only dependencies through
# LINK_ONLY in the exported interface. They need target names at consumption
# time, but no headers or link flags. Fully shared builds absorb these dependencies.
if(NOT AvogadroLibs_BUILD_SHARED_LIBS OR AvogadroLibs_BUILD_STATIC_PLUGINS)
  foreach(_dependency gif-h tinycolormap tomlplusplus nlohmann_json cppoptlib)
    if(NOT TARGET ${_dependency})
      add_library(${_dependency} INTERFACE IMPORTED)
    endif()
  endforeach()
  unset(_dependency)
endif()

if(NOT TARGET AvogadroCore)
  include("${AvogadroLibs_CMAKE_DIR}/AvogadroLibsTargets.cmake")
endif()
